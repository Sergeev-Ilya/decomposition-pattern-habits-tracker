# Run node scripts/init-local-env.mjs from the repository root to generate backend/.env.
FRONTEND_PORT=8880
APP_ORIGIN=http://localhost:8880
COOKIE_SECURE=false
AUTH_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
HABITS_DB_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
INTERNAL_SERVICE_KEY=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_BYTES
